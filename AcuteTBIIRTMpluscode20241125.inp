TITLE: Nelson et al. - 
  A model of traumatic brain injury severity from clinical, neuroimaging, and 
  blood-based indicators
! Script 2/2 - exploratory factor analysis (EFA) model

DATA: FILE = "ShareDataMplus.dat";

VARIABLE: 
NAMES = id CT_SkullFx_R CT_Contusion_R CT_Shear_R CT_ExtraaxHematoma_R CT_EDH_R
     CT_SDH_R CT_SAH_R CT_IVH_R CT_Edema_R CT_DownwardHerniation_R
     CT_UpwardCerebellarHerniation_R CT_DuretHemorrhage_R CT_MidlineShift_R
     LOCDuration_R PTADuration_R GcsVerbal GcsMotor GcsEyes
     gfap_cat uchl_cat nse_cat s100_cat crp_cat pupils; 

USEVARIABLES = CT_SAH_R CT_SDH_R CT_SkullFx_R CT_Contusion_R CT_Edema_R 
               CT_DownwardHerniation_R CT_MidlineShift_R CT_Shear_R CT_EDH_R 
               CT_UpwardCerebellarHerniation_R CT_IVH_R CT_DuretHemorrhage_R 
               CT_ExtraaxHematoma_R
               GcsEyes GcsVerbal GcsMotor pupils LOCDuration_R PTADuration_R 
               gfap_cat uchl_cat nse_cat s100_cat crp_cat;

CATEGORICAL =  CT_SAH_R CT_SDH_R CT_SkullFx_R CT_Contusion_R CT_Edema_R 
               CT_DownwardHerniation_R CT_MidlineShift_R CT_Shear_R CT_EDH_R 
               CT_UpwardCerebellarHerniation_R CT_IVH_R CT_DuretHemorrhage_R 
               CT_ExtraaxHematoma_R
               GcsEyes GcsVerbal GcsMotor pupils LOCDuration_R PTADuration_R 
               gfap_cat uchl_cat nse_cat s100_cat crp_cat;

MISSING = .;
MISSING = "T"; !Define untestable GCS code as missing
MISSING = "P"; !Define untestable GCS code as missing
MISSING = "S"; !Define untestable GCS code as missing

  ANALYSIS: ESTIMATOR = WLSMV;
            ROTATION = GEOMIN;
            TYPE=EFA 1 3;
            PROCESSORS=4;

  OUTPUT:	SAMPSTAT RESIDUAL;


